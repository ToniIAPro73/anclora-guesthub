# Anclora GuestHub environment template.
# Copy values into .env.local for local development. Never commit real secrets.
#
# Rename note (2026-08): this product was renamed Anclora SyncXML → Anclora GuestHub.
# Canonical variable names are now GUESTHUB_* / NEXUS_GUESTHUB_*. The application
# still reads the legacy SYNCXML_* / NEXUS_SYNCXML_* names as fallback, so existing
# deployments keep working. Legacy names are listed in comments for reference.

# Database
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/anclora_syncxml_dev"
DIRECT_URL="postgresql://USER:PASSWORD@localhost:5432/anclora_syncxml_dev"
GUESTHUB_ENABLE_PERSISTENT_STORAGE="false"

# App URLs
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
GUESTHUB_APP_URL="http://localhost:3000"
GUESTHUB_LOGIN_URL="http://localhost:3000/login"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Auth and sessions
SESSION_SECRET="replace-with-openssl-rand-base64-32"
AUTH_SECRET="replace-with-different-compatible-secret-if-used"
GUESTHUB_ADMIN_EMAIL="admin@example.com"
GUESTHUB_ADMIN_PASSWORD="replace-with-local-admin-password"
GUESTHUB_DISABLE_AUTH="false"
GUESTHUB_LOCAL_DEMO="false"
GUESTHUB_ALLOW_LEGACY_SECRET_COOKIE="false"

# Admin access endpoint
GUESTHUB_ADMIN_ACCESS_ENABLED="false"
GUESTHUB_ADMIN_ACCESS_TOKEN=""
GUESTHUB_ADMIN_ACCESS_ALLOWED_ENV="development,preview"
GUESTHUB_ADMIN_ACCESS_REDIRECT="/app"
GUESTHUB_ALLOW_ADMIN_ACCESS_IN_PRODUCTION="false"

# Encryption
# Legacy fallback SYNCXML_ENCRYPTION_KEY / SYNCXML_FILE_ENCRYPTION_KEY is CRITICAL:
# without it, data encrypted before the rename would be unreadable.
GUESTHUB_ENCRYPTION_KEY=""
GUESTHUB_FILE_ENCRYPTION_KEY=""

# Internal APIs and scheduled jobs
GUESTHUB_INTERNAL_API_SECRET=""
CRON_SECRET=""

# Email / Resend
RESEND_API_KEY=""
RESEND_FROM="Anclora GuestHub <piloto@anclora.com>"
RESEND_FROM_EMAIL="Anclora GuestHub <piloto@anclora.com>"
RESEND_REPLY_TO="antonio@anclora.com"
GUESTHUB_PILOT_REQUEST_TO="antonio@anclora.com"
GUESTHUB_FEEDBACK_TO="antonio@anclora.com"
ADMIN_EMAILS="antonio@anclora.com"

# Nexus / Hermes integrations
# Legacy NEXUS_SYNCXML_WEBHOOK_URL / NEXUS_SYNCXML_WEBHOOK_SECRET are still read as fallback.
NEXUS_GUESTHUB_WEBHOOK_URL=""
NEXUS_GUESTHUB_WEBHOOK_SECRET=""
NEXUS_WEBHOOK_URL=""
NEXUS_INTERNAL_API_KEY=""
HERMES_WORKER_URL=""
HERMES_WORKER_API_KEY=""

# SES.HOSPEDAJES. Keep production sending disabled until preproduction evidence exists.
# GUESTHUB_SES_APPLICATION default "Anclora SyncXML" is the registered SES application
# name — do not rename (legal registration compatibility).
GUESTHUB_SES_ENV="pre"
GUESTHUB_SES_ENDPOINT=""
GUESTHUB_SES_USERNAME=""
GUESTHUB_SES_PASSWORD=""
GUESTHUB_SES_LANDLORD_CODE=""
GUESTHUB_SES_APPLICATION="Anclora SyncXML"
GUESTHUB_SES_ALLOW_PRODUCTION_SEND="false"
GUESTHUB_SES_ALLOW_INSECURE_TLS="false"

# Optional blob storage and document ingestion
BLOB_READ_WRITE_TOKEN=""
ENABLE_MINERU_PARSER="false"
MINERU_AGENT_INGEST_PATH=""
MINERU_DEFAULT_BACKEND="pipeline"
MINERU_OUTPUT_BASE=""
MINERU_PARSE_TIMEOUT_MS="180000"
